{
  "name": "case-compass",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Case Compass - privacy-first case management PWA",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "check-links": "node scripts/check-links.mjs",
